# Add values only in Vercel Project Settings -> Environment Variables.
# Never put real values in this file or commit them to GitHub.

DATABASE_URL=
ARYA_ADMIN_PASSWORD=
ARYA_SESSION_SECRET=
ARYA_RETENTION_DAYS=90

OPENAI_API_KEY=
OPENAI_MODEL=

# Separate, reviewed read-only source APIs. Never put admin passwords in URLs.
ARYA_CRM_READ_URL=
ARYA_CRM_READ_TOKEN=
ARYA_COURSE_READ_URL=
ARYA_COURSE_READ_TOKEN=
# Vercel Cron authentication; generated in production settings, not in Git.
CRON_SECRET=

# Local WhatsApp Web transport. Keep sends off until recipients and dry-run are reviewed.
ARYA_WHATSAPP_TRANSPORT=web
ARYA_LOCAL_WHATSAPP_ENABLED=false
ARYA_LOCAL_WHATSAPP_INGEST_SECRET=
ARYA_LOCAL_WHATSAPP_ALLOWED_CHATS=[]
DERS_COORDINATOR_ENABLED=false
DERS_COORD_DATABASE_URL=
