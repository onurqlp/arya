# Add values only in Vercel Project Settings -> Environment Variables.
# Never put real values in this file or commit them to GitHub.

DATABASE_URL=
ARYA_ADMIN_PASSWORD=
ARYA_SESSION_SECRET=
ARYA_RETENTION_DAYS=90

OPENAI_API_KEY=
OPENAI_MODEL=

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Meta credentials used by the existing webhook and separately approved reply flow.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=

# Private WhatsApp approval DMs. Use comma-separated owner phone IDs in international format, digits only.
ARYA_OWNER_WA_IDS=
# A Meta-approved template is needed for owner notifications outside the 24-hour owner chat window.
ARYA_OWNER_NOTIFICATION_TEMPLATE=
ARYA_OWNER_NOTIFICATION_LANG=tr

# Separate, reviewed read-only source APIs. Never put admin passwords in URLs.
ARYA_CRM_READ_URL=
ARYA_CRM_READ_TOKEN=
ARYA_COURSE_READ_URL=
ARYA_COURSE_READ_TOKEN=
# Vercel Cron authentication; generated in production settings, not in Git.
CRON_SECRET=
